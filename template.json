{
    "log": {
        "level": "info",
        "timestamp": true
    },
    "experimental": {
        "cache_file": {
            "enabled": true,
            "store_fakeip": true,
            "store_dns": true
        }
    },
    "services": [
        {
            "type": "api",
            "tag": "dashboard",
            "listen": "127.0.0.1",
            "listen_port": 9391,
            "secret": "xx11",
            "access_control_allow_private_network": false,
            "access_control_allow_origin": [
                "http://localhost:9391",
                "https://sing-box-dashboard.sagernet.org"
            ],
            "dashboard": {
                "enabled": true,
                "http_client": {
                    "disable_version_fallback": true,
                    "detour": "albatross"
                }
            }
        }
    ],
    "dns": {
        "servers": [
            {
                "type": "https",
                "tag": "dialing",
                "server": "223.5.5.5"
            },
            {
                "type": "https",
                "tag": "cn_dns",
                "server": "dns.alidns.com",
                "domain_resolver": {
                    "server": "dialing"
                }
            },
            {
                "type": "https",
                "tag": "proxy_dns",
                "server": "cloudflare-dns.com",
                "detour": "albatross"
            },
            {
                "type": "fakeip",
                "tag": "fake_dns",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "fc00::/18"
            }
        ],
        "rules": [
            {
                "clash_mode": "direct",
                "server": "cn_dns"
            },
            {
                "clash_mode": "global",
                "server": "proxy_dns"
            },
            {
                "rule_set": "lan_nonip",
                "server": "cn_dns"
            },
            {
                "rule_set": "private",
                "server": "cn_dns"
            },
            {
                "rule_set": "ads",
                "action": "reject"
            },
            {
                "query_type": ["A", "AAAA"],
                "server": "fake_dns"
            },
            {
                "rule_set": "direct_nonip",
                "server": "cn_dns"
            },
            {
                "rule_set": "apple_cdn_nonip",
                "server": "cn_dns"
            },
            {
                "rule_set": "apple_cn_nonip",
                "server": "cn_dns"
            },
            {
                "rule_set": "ms_cdn_nonip",
                "server": "cn_dns"
            },
            {
                "rule_set": "domestic_nonip",
                "server": "cn_dns"
            },
            {
                "rule_set": ["cnsite"],
                "server": "cn_dns"
            }
        ],
        "final": "proxy_dns"
    },
    "inbounds": [
        {
            "type": "tun",
            "tag": "tun-in",
            "mtu": 9000,
            "address": ["172.18.0.1/30", "fdfe:dcba:9876::1/126"],
            "dns_mode": "hijack",
            "auto_route": true,
            "strict_route": true,
            "stack": "mixed"
        },
        {
            "type": "mixed",
            "tag": "mixed-in",
            "listen": "0.0.0.0",
            "listen_port": 9393
        }
    ],
    "outbounds": [
        {
            "type": "selector",
            "tag": "albatross",
            "interrupt_exist_connections": true,
            "outbounds": ["cuckoo", "godwit", "seagull"],
            "default": "cuckoo"
        },
        {
            "type": "selector",
            "tag": "cuckoo",
            "interrupt_exist_connections": true,
            "outbounds": ["urltest"],
            "default": "urltest"
        },
        {
            "type": "selector",
            "tag": "godwit",
            "interrupt_exist_connections": true,
            "outbounds": ["urltest"],
            "default": "urltest"
        },
        {
            "type": "selector",
            "tag": "seagull",
            "interrupt_exist_connections": true,
            "outbounds": ["urltest"],
            "default": "urltest"
        },
        {
            "type": "selector",
            "tag": "ai",
            "interrupt_exist_connections": true,
            "outbounds": ["albatross", "cuckoo", "godwit", "seagull"],
            "default": "albatross"
        },
        {
            "type": "selector",
            "tag": "stream",
            "interrupt_exist_connections": true,
            "outbounds": ["albatross", "cuckoo", "godwit", "seagull"],
            "default": "albatross"
        },
        {
            "type": "selector",
            "tag": "stream-cn",
            "interrupt_exist_connections": true,
            "outbounds": ["albatross", "cuckoo", "godwit", "seagull", "swift"],
            "default": "swift"
        },
        {
            "type": "selector",
            "tag": "apple",
            "interrupt_exist_connections": true,
            "outbounds": ["albatross", "cuckoo", "godwit", "seagull", "swift"],
            "default": "albatross"
        },
        {
            "type": "selector",
            "tag": "apple-cn",
            "interrupt_exist_connections": true,
            "outbounds": ["albatross", "cuckoo", "godwit", "seagull", "swift"],
            "default": "swift"
        },
        {
            "type": "urltest",
            "tag": "urltest",
            "interrupt_exist_connections": true,
            "outbounds": []
        },
        {
            "type": "direct",
            "tag": "swift"
        }
    ],
    "route": {
        "rules": [
